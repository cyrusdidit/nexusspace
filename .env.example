; Use an application account with only SELECT, INSERT, UPDATE, and DELETE on this schema.
; Run schema migrations separately with a database administrator account.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexusspace
DB_USER=nexusspace_app
DB_PASSWORD=replace-with-a-random-secret

SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1/nexusspace/pages/spotify-callback.php
NEXUSSPACE_URL=http://localhost/nexusspace
NEXUSSPACE_APP_KEY=
STEAM_WEB_API_KEY=
; Set to 1 when HTTPS terminates at a trusted reverse proxy.
NEXUSSPACE_FORCE_SECURE_COOKIE=0
